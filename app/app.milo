// tsunami: is a tsunami coming for me, did the ground shake, in words a five
// year old can read.
// The server proxies the two NOAA tsunami warning centers' Atom feeds and the
// Climate Prediction Center's El Nino data (none of them send CORS headers),
// parses them into small JSON, and caches every upstream behind one TtlCache.
// Everything CORS-open (USGS quakes, NWS point alerts, Open-Meteo elevation,
// geocoding and sea temperature) the page fetches itself. The page is compiled
// in with embedFile.
from "std/http" import {
    Context, Response, Router, serveRouter
}
from "std/argparse" import {
    ArgParser
}
from "std/json" import {
    Json, JsonArr
}
from "std/set" import {
    HashSet
}
from "std/log" import {
    Log
}
from "std/fetch" import {
    FetchOptions, FetchTimeouts, fetchWithTimeout
}
from "std/cache" import {
    TtlCache
}
from "std/time" import {
    Duration, sleepMs
}
from "std/strconv" import {
    parseFloat
}
from "std/html" import {
    Html
}
from "std/math" import {
    Math
}

// The centers reissue a bulletin minutes apart during an event, so a minute
// is as stale as a warning is allowed to get.
pub let FEED_FRESH_MS: i64 = 60000
// CPC updates ENSO weekly (Mondays) and monthly (second Thursday).
pub let ENSO_FRESH_MS: i64 = 3 * 3600 * 1000
// Past fresh, an answer is served only while its upstream is failing.
pub let STALE_MS: i64 = 2 * 24 * 3600 * 1000

pub var cache: TtlCache<string, string> = TtlCache.withCapacity(Duration.millis(STALE_MS), 64)
// Keys with an upstream fetch running: handlers are green tasks, so without
// this a burst of page loads sends one identical upstream call each.
pub var inFlight: HashSet<string> = HashSet.new()

pub var contactUa: string = "milo-tsunami"

fn freshBody(key: &string, maxAgeMs: i64): Option<string> {
    return cache.getWithin(key, Duration.millis(maxAgeMs))
}

// Cached, coalesced GET. A non-2xx or empty body is never cached; the last good
// body (up to STALE_MS old) stands in while upstream is down.
fn cachedFetch(key: &string, url: string, freshMs: i64): Option<string> {
    if let Some(b) = freshBody(key, freshMs) {
        return Option.Some(b)
    }
    if inFlight.contains(key) {
        var waited: i64 = 0
        while inFlight.contains(key) && waited < 15000 {
            sleepMs(25)
            waited += 25
        }
        if let Some(b) = freshBody(key, freshMs) {
            return Option.Some(b)
        }
    }
    inFlight.add(key.clone())
    var body = ""
    let opts = FetchOptions {
        method: "GET",
        headers: "User-Agent: " + contactUa.clone(),
        body: "",
    }
    match fetchWithTimeout(url, opts, FetchTimeouts { connectMs: 4000, totalMs: 10000 }) {
        Ok(resp) => {
            if resp.status >= 200 && resp.status < 300 {
                body = resp.body.clone()
            } else {
                Log.str("url", url).int("status", resp.status as i64).warn("upstream failed")
            }
        }
        Err(e) => {
            Log.str("url", url).str("err", $"{e}").warn("upstream unreachable")
        }
    }
    // Before any return: a key left in flight stalls every later request for it.
    inFlight.remove(key)
    if body.len > 0 {
        cache.putFor(key.clone(), body.clone(), Duration.millis(STALE_MS))
        return Option.Some(body)
    }
    return freshBody(key, STALE_MS)
}

// Text between `open` and the next `close` at or after `from`, or "".
fn between(s: &string, open: &string, close: &string, from: i64): string {
    let Some(a) = s.indexOfFrom(open, from) else {
        return ""
    }
    let start = a + open.len
    let Some(b) = s.indexOfFrom(close, start) else {
        return ""
    }
    return s.slice(start, b).clone()
}

// Markup to plain text: tags dropped, entities decoded, whitespace runs folded.
fn plain(s: &string): string {
    var out = ""
    var inTag = false
    var lastSpace = true
    var i: i64 = 0
    while i < s.len {
        let c = s[i]
        if c == '<' {
            inTag = true
        } else if c == '>' {
            inTag = false
            if !lastSpace {
                out.push(' ')
                lastSpace = true
            }
        } else if !inTag {
            if c == ' ' || c == '\n' || c == '\r' || c == '\t' {
                if !lastSpace {
                    out.push(' ')
                    lastSpace = true
                }
            } else {
                out.push(c)
                lastSpace = false
            }
        }
        i += 1
    }
    return Html.unescape(out.trim()).replace("\u{a0}", " ").trim()
}

// One labeled field of a bulletin summary: "<strong>Label:</strong> value<br/>".
fn field(summary: &string, label: &string): string {
    let Some(a) = summary.indexOf(label) else {
        return ""
    }
    let rest = summary.slice(a + label.len, summary.len)
    // The value ends at the next labeled field.
    var end = rest.len
    if let Some(b) = rest.indexOf("<strong>") {
        end = b
    }
    if let Some(b) = rest.indexOf("<b>") {
        if b < end {
            end = b
        }
    }
    return plain(rest.slice(0, end))
}

fn num(s: &string): f64 {
    return parseFloat(s.trim()) ?? 0.0
}

// The newest entry of one center's Atom feed. Each feed holds only that
// center's latest bulletin, which may be days old and only "Information".
pub fn parseFeed(center: &string, xml: &string): string {
    let Some(e) = xml.indexOf("<entry>") else {
        return Json.obj().str("center", center).bool("empty", true).build()
    }
    let entry = between(xml, "<entry>", "</entry>", e)
    let summary = between(entry, "<summary", "</summary>", 0)
    var bulletin = ""
    if let Some(alt) = entry.indexOf("rel=\"alternate\"") {
        bulletin = between(entry, "href=\"", "\"", alt)
    }
    var note = field(summary, "<b>Note:</b>")
    // The note is NOAA's bulleted all-caps prose; "*" starts each bullet.
    note = note.replace("* ", "\n").trim()
    return Json.obj()
        .str("center", center)
        .str("title", plain(between(xml, "<title>", "</title>", 0)))
        .str("updated", plain(between(entry, "<updated>", "</updated>", 0)))
        .float("lat", num(between(entry, "<geo:lat>", "</geo:lat>", 0)))
        .float("lon", num(between(entry, "<geo:long>", "</geo:long>", 0)))
        .str("category", field(summary, "Category:</strong>"))
        .str("magnitude", field(summary, "Preliminary Magnitude: </strong>"))
        .str("region", plain(between(entry, "<title>", "</title>", 0)))
        .str("note", note)
        .str("bulletin", bulletin)
        .build()
}

// GET /api/centers -> {"centers":[{center,title,updated,lat,lon,category,magnitude,region,note,bulletin}]}
pub fn centersHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    var arr = Json.arr()
    var any = false
    // NTWC (Palmer AK) covers the US/Canada coasts; PTWC (Honolulu) Hawaii,
    // the territories and the international Pacific and Caribbean.
    if let Some(x) = cachedFetch("ntwc", "https://www.tsunami.gov/events/xml/PAAQAtom.xml", FEED_FRESH_MS) {
        arr = arr.raw(parseFeed("ntwc", x))
        any = true
    }
    if let Some(x) = cachedFetch("ptwc", "https://www.tsunami.gov/events/xml/PHEBAtom.xml", FEED_FRESH_MS) {
        arr = arr.raw(parseFeed("ptwc", x))
        any = true
    }
    if !any {
        ctx.setStatus(502)
        return ctx.json("{\"error\":\"tsunami.gov unavailable\"}")
    }
    return ctx.json(Json.obj().arr("centers", arr).build())
}

// "ENSO Alert System Status: El Nino Advisory / La Nina Watch" and the synopsis
// sentence, out of CPC's monthly discussion page.
pub fn parseDiscussion(html: &string): string {
    let text = plain(html)
    var status = ""
    if let Some(a) = text.indexOf("ENSO Alert System Status:") {
        let rest = text.slice(a + 25, text.len).trim()
        // The status is the run of words before "Synopsis:".
        if let Some(b) = rest.indexOf("Synopsis:") {
            status = rest.slice(0, b).trim().clone()
        }
    }
    var synopsis = ""
    if let Some(a) = text.indexOf("Synopsis:") {
        let rest = text.slice(a + 9, text.len).trim()
        if let Some(b) = rest.indexOf(". ") {
            synopsis = rest.slice(0, b + 1).clone()
        } else {
            synopsis = rest.slice(0, if rest.len < 400 { rest.len } else { 400 }).clone()
        }
    }
    return Json.obj().str("status", status).str("synopsis", synopsis).build()
}

// oni.ascii.txt rows are "  JAS 2026  29.12   2.16": season, year, total, anomaly.
// Only the last `keep` rows are wanted.
pub fn parseOni(raw: &string, keep: i64): JsonArr {
    var rows: Vec<string> = []
    for line in raw.lines() {
        let f = line.split(" ").filter((w: &string): bool => w.len > 0)
        if f.len != 4 || f[0] == "SEAS" {
            continue
        }
        rows.push(Json.arr().str(f[0]).int(parseFloat(f[1]).map((v: f64): i64 => v as i64) ?? 0).float(num(f[3])).build())
    }
    var arr = Json.arr()
    var i = if rows.len > keep { rows.len - keep } else { 0 }
    while i < rows.len {
        arr = arr.raw(rows[i])
        i += 1
    }
    return arr
}

// wksst9120.for: weekly rows "07OCT2026  26.1 5.2  29.0 4.1  30.0 3.3  29.9 1.3",
// regions Nino1+2, Nino3, Nino3.4, Nino4 (each SST then anomaly). The last row is newest.
pub fn parseWeekly(raw: &string): string {
    var last = ""
    for line in raw.lines() {
        let f = line.split(" ").filter((w: &string): bool => w.len > 0)
        if f.len == 9 && f[0].len == 9 {
            last = Json.obj().str("week", f[0]).float("nino34", num(f[5])).float("nino34Anom", num(f[6])).build()
        }
    }
    return if last.len > 0 { last } else { "null" }
}

// soi: two blocks of "YEAR  JAN ... DEC" rows (anomaly, then standardized),
// fixed width: a 4-digit year then twelve 6-char fields, -999.9 for missing.
// The newest standardized months, oldest first, as [year, month, value].
pub fn parseSoi(raw: &string, keep: i64): JsonArr {
    var rows: Vec<string> = []
    var standardized = false
    for line in raw.lines() {
        if line.contains("STANDARDIZED") {
            standardized = true
            rows = []
            continue
        }
        if !standardized || line.len < 4 + 6 {
            continue
        }
        let Some(year) = parseFloat(line.slice(0, 4).clone()) else {
            continue
        }
        var m: i64 = 0
        while m < 12 && 4 + (m + 1) * 6 <= line.len {
            let v = num(line.slice(4 + m * 6, 4 + (m + 1) * 6))
            if v > -999.0 {
                rows.push(Json.arr().int(year as i64).int(m + 1).float(v).build())
            }
            m += 1
        }
    }
    var arr = Json.arr()
    var i = if rows.len > keep { rows.len - keep } else { 0 }
    while i < rows.len {
        arr = arr.raw(rows[i])
        i += 1
    }
    return arr
}

// heat_content_index.txt rows "2026    9     2.23      2.93       3.39": year,
// month, then 300 m ocean heat anomaly for three equatorial boxes. The middle
// one (160E-80W) is the one CPC charts.
pub fn parseHeat(raw: &string, keep: i64): JsonArr {
    var rows: Vec<string> = []
    for line in raw.lines() {
        let f = line.split(" ").filter((w: &string): bool => w.len > 0)
        if f.len != 5 || parseFloat(f[0].clone()).isNone() {
            continue
        }
        rows.push(Json.arr().int(num(f[0]) as i64).int(num(f[1]) as i64).float(num(f[3])).build())
    }
    var arr = Json.arr()
    var i = if rows.len > keep { rows.len - keep } else { 0 }
    while i < rows.len {
        arr = arr.raw(rows[i])
        i += 1
    }
    return arr
}

// GET /api/enso -> {"discussion":{status,synopsis},"oni":[[season,year,anom]],"weekly":{week,nino34,nino34Anom},
//                   "soi":[[year,month,value]],"heat":[[year,month,anom]]}
pub fn ensoHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    var o = Json.obj()
    var any = false
    if let Some(h) = cachedFetch("ensodisc", "https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/enso_advisory/ensodisc.shtml", ENSO_FRESH_MS) {
        o = o.raw("discussion", parseDiscussion(h))
        any = true
    }
    if let Some(t) = cachedFetch("oni", "https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt", ENSO_FRESH_MS) {
        // 30 years: enough to show 1997 and 2015, the two monsters this one is compared to.
        o = o.arr("oni", parseOni(t, 12 * 30))
        any = true
    }
    if let Some(t) = cachedFetch("weekly", "https://www.cpc.ncep.noaa.gov/data/indices/wksst9120.for", ENSO_FRESH_MS) {
        o = o.raw("weekly", parseWeekly(t))
        any = true
    }
    if let Some(t) = cachedFetch("soi", "https://www.cpc.ncep.noaa.gov/data/indices/soi", ENSO_FRESH_MS) {
        o = o.arr("soi", parseSoi(t, 24))
        any = true
    }
    if let Some(t) = cachedFetch("heat", "https://www.cpc.ncep.noaa.gov/products/analysis_monitoring/ocean/index/heat_content_index.txt", ENSO_FRESH_MS) {
        o = o.arr("heat", parseHeat(t, 24))
        any = true
    }
    if !any {
        ctx.setStatus(502)
        return ctx.json("{\"error\":\"cpc.ncep.noaa.gov unavailable\"}")
    }
    return ctx.json(o.build())
}

// Natural Earth 50m coastline, one "lat lon" vertex per line, "#" starting
// each polyline. Elevation alone can't say whether a tsunami can reach you:
// Sacramento sits at 9 m but 120 km from the sea. NOAA's advice is 100 ft up
// or 2 miles inland, so the page needs both numbers.
pub var coastLat: Vec<f64> = []
pub var coastLon: Vec<f64> = []
// True where a vertex starts a new polyline, so no segment joins two coasts.
pub var coastStart: Vec<bool> = []

pub fn coastInit(): void {
    let raw = @embedFile("data/coast.txt")
    var start = true
    for line in raw.lines() {
        if line.len == 0 {
            continue
        }
        if line[0] == '#' {
            start = true
            continue
        }
        let f = line.split(" ")
        if f.len != 2 {
            continue
        }
        coastLat.push(num(f[0]))
        coastLon.push(num(f[1]))
        coastStart.push(start)
        start = false
    }
}

// Kilometres from (lat, lon) to the nearest coastline segment, on a local flat
// projection: good to well under the 50m data's own error at the distances
// that matter here (0 to 20 km).
pub fn coastKm(lat: f64, lon: f64): f64 {
    let kx = 111.32 * Math.cos(lat * 3.141592653589793 / 180.0)
    let ky = 110.57
    var best = 1.0e12
    var px = 0.0
    var py = 0.0
    var i: i64 = 0
    while i < coastLat.len {
        var dl = coastLon[i] - lon
        if dl > 180.0 {
            dl -= 360.0
        } else if dl < -180.0 {
            dl += 360.0
        }
        let x = dl * kx
        let y = (coastLat[i] - lat) * ky
        if !coastStart[i] {
            // Distance from the origin to segment (px,py)-(x,y), squared.
            let sx = x - px
            let sy = y - py
            let len2 = sx * sx + sy * sy
            var t = 0.0
            if len2 > 0.0 {
                t = -(px * sx + py * sy) / len2
                if t < 0.0 {
                    t = 0.0
                } else if t > 1.0 {
                    t = 1.0
                }
            }
            let cx = px + t * sx
            let cy = py + t * sy
            let d2 = cx * cx + cy * cy
            if d2 < best {
                best = d2
            }
        }
        px = x
        py = y
        i += 1
    }
    return Math.sqrt(best)
}

// GET /api/coast?lat=&lon= -> {"km": distance to the nearest coastline}
pub fn coastHandler(ctx: &mut Context): Response {
    let lat = parseFloat(ctx.query("lat") ?? "")
    let lon = parseFloat(ctx.query("lon") ?? "")
    if lat.isNone() || lon.isNone() {
        ctx.setStatus(400)
        return ctx.json("{\"error\":\"lat and lon required\"}")
    }
    ctx.setHeader("Cache-Control", "public, max-age=86400")
    return ctx.json(Json.obj().float("km", coastKm(lat ?? 0.0, lon ?? 0.0)).build())
}

// Typeahead index (tools/places.py): US places down to small towns plus world
// cities of 15k+, sorted by population, so a first-match scan is ranked. Served
// from memory because a remote geocoder per keystroke is too slow to feel live.
pub struct Place {
    name: string,
    region: string,
    cc: string,
    country: string,
    lat: string,
    lon: string,
    pop: f64,
    // Lowercased once at load; 48k rows are scanned per keystroke.
    key: string,
    altKeys: Vec<string>,
}

pub var places: Vec<Place> = []

pub let MAX_SUGGESTIONS: i64 = 8

pub fn placesInit(): void {
    let raw = @embedFile("data/places.tsv")
    for line in raw.lines() {
        let f = line.split("\t")
        if f.len < 7 {
            continue
        }
        var alts: Vec<string> = []
        if f.len > 7 {
            for a in f[7].split(";") {
                let alt = a.trim()
                if alt.len > 0 {
                    alts.push(alt.clone())
                }
            }
        }
        places.push(Place {
            name: f[0].clone(),
            region: f[1].clone(),
            cc: f[2].clone(),
            country: f[3].clone(),
            lat: f[4].clone(),
            lon: f[5].clone(),
            pop: num(f[6]),
            key: f[0].toLower(),
            altKeys: alts,
        })
    }
}

fn placeStartsWith(p: &Place, q: &string): bool {
    if p.key.startsWith(q) {
        return true
    }
    for k in p.altKeys {
        if k.startsWith(q) {
            return true
        }
    }
    return false
}

fn placeContains(p: &Place, q: &string): bool {
    if p.key.contains(q) {
        return true
    }
    for k in p.altKeys {
        if k.contains(q) {
            return true
        }
    }
    return false
}

// "santa cruz, ca" or "perth, australia": the part after the comma narrows by
// state code, region, country code or country name.
fn placeMatchesRegion(p: &Place, rq: &string): bool {
    if rq.len == 0 {
        return true
    }
    return p.cc.toLower() == rq || p.region.toLower().startsWith(rq) || p.country.toLower().startsWith(rq)
}

fn placeJson(p: &Place): string {
    return Json.obj().str("name", p.name).str("region", p.region).str("cc", p.cc).str("country", p.country)
        .raw("lat", p.lat).raw("lon", p.lon).build()
}

pub struct Candidate {
    idx: i64,
    score: f64,
}

// The reader's own country counts thirty times its population, so "santa cr"
// offers Santa Cruz, CA to a US reader ahead of Santa Cruz, Bolivia, while
// "tok" still offers Tokyo ahead of Tokeland, WA.
pub let HOME_BOOST: f64 = 30.0
// Prefix matches considered for ranking; the list is population-sorted, so
// anything past this is too small to outrank them.
pub let MAX_CANDIDATES: i64 = 400

// GET /api/places?q=santa%20cr&home=US -> [{name,region,cc,country,lat,lon}], best first
pub fn placesHandler(ctx: &mut Context): Response {
    let raw = ((ctx.query("q") ?? "").trim()).toLower()
    let home = (ctx.query("home") ?? "").toUpper()
    let parts = raw.split(",")
    let q = parts[0].trim()
    var rq = ""
    if parts.len > 1 {
        rq = parts[1].trim()
    }
    if q.len == 0 {
        return ctx.json("[]")
    }
    ctx.setHeader("Cache-Control", "public, max-age=86400")
    var cands: Vec<Candidate> = []
    var i: i64 = 0
    while i < places.len && cands.len < MAX_CANDIDATES {
        if placeStartsWith(places[i], q) && placeMatchesRegion(places[i], rq) {
            let boost = if places[i].cc == home { HOME_BOOST } else { 1.0 }
            cands.push(Candidate { idx: i, score: places[i].pop * boost })
        }
        i += 1
    }
    cands.sortBy((a: &Candidate, b: &Candidate): i64 => if a.score > b.score { -1 } else if a.score < b.score { 1 } else { 0 })
    var arr = Json.arr()
    var n: i64 = 0
    for c in cands {
        if n >= MAX_SUGGESTIONS {
            break
        }
        arr = arr.raw(placeJson(places[c.idx]))
        n += 1
    }
    // Interior matches only backfill, so "york" offers York before New York.
    if n < MAX_SUGGESTIONS {
        for p in places {
            if n >= MAX_SUGGESTIONS {
                break
            }
            if !placeStartsWith(p, q) && placeContains(p, q) && placeMatchesRegion(p, rq) {
                arr = arr.raw(placeJson(p))
                n += 1
            }
        }
    }
    return ctx.json(arr.build())
}

// no-store: this server sends no ETag, so no-cache would never revalidate and
// a deploy would stay invisible on phones that already opened the page.
pub fn indexHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return ctx.html(@embedFile("public/index.html"))
}

pub fn scriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/app.js"))
}

pub fn quakesPageHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return ctx.html(@embedFile("public/earthquakes.html"))
}

pub fn commonHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/common.js"))
}

pub fn quakesScriptHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/javascript; charset=utf-8", @embedFile("public/quakes.js"))
}

pub fn styleHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "text/css; charset=utf-8", @embedFile("public/style.css"))
}

pub fn manifestHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "no-store")
    return Response.Status(200, "application/manifest+json; charset=utf-8", @embedFile("public/manifest.webmanifest"))
}

pub fn iconHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=86400")
    return Response.Status(200, "image/svg+xml", @embedFile("public/icons/icon.svg"))
}

// Share thumbnails (tools/og.sh). Link-preview crawlers fetch these once and
// cache them, so a day is plenty.
pub fn ogTsunamiHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=86400")
    return Response.Status(200, "image/png", @embedFile("public/og-tsunami.png"))
}

pub fn ogQuakesHandler(ctx: &mut Context): Response {
    ctx.setHeader("Cache-Control", "public, max-age=86400")
    return Response.Status(200, "image/png", @embedFile("public/og-quakes.png"))
}

pub fn healthHandler(ctx: &mut Context): Response {
    return ctx.json(Json.obj().str("status", "ok").str("app", "tsunami").int("cached", cache.len()).int("coastVertices", coastLat.len).build())
}

// Every route also answers under /tsunami: the earthquakes page is served at
// /earthquakes with <base href="/tsunami/">, so its assets and API calls carry
// the prefix. nginx strips it in prod; locally this alias catches them.
fn addRoutes(r: &mut Router, pre: string): void {
    r.get(pre + "/", indexHandler)
    r.get(pre + "/index.html", indexHandler)
    r.get(pre + "/app.js", scriptHandler)
    r.get(pre + "/earthquakes", quakesPageHandler)
    r.get(pre + "/common.js", commonHandler)
    r.get(pre + "/quakes.js", quakesScriptHandler)
    r.get(pre + "/style.css", styleHandler)
    r.get(pre + "/manifest.webmanifest", manifestHandler)
    r.get(pre + "/icons/icon.svg", iconHandler)
    r.get(pre + "/og-tsunami.png", ogTsunamiHandler)
    r.get(pre + "/og-quakes.png", ogQuakesHandler)
    r.get(pre + "/api/centers", centersHandler)
    r.get(pre + "/api/enso", ensoHandler)
    r.get(pre + "/api/coast", coastHandler)
    r.get(pre + "/api/places", placesHandler)
}

pub fn main(): i32 {
    var parser = ArgParser.new("tsunami", "tsunami and El Nino status for where you are")
    parser.addI64("port", "p", "port to listen on", 3000)
    parser.addString("contact", "c", "contact string for the upstream User-Agent", "")
    let args = parser.parse()
    let port = args.getU16("port")
    let contact = args.getString("contact") ?? ""
    if contact.len > 0 {
        contactUa = "milo-tsunami (" + contact + ")"
    }
    coastInit()
    placesInit()
    // journald stamps every line itself.
    Log.setTimestamps(false)
    Log.int("port", port as i64).info("tsunami listening")

    var r: Router = Router.new()
    addRoutes(&mut r, "")
    addRoutes(&mut r, "/tsunami")
    r.get("/healthz", healthHandler)

    if let Err(msg) = serveRouter(port, r) {
        Log.str("err", msg).error("serve failed")
        return 1
    }
    return 0
}
